# What never belongs in the public tree. Everything else here ships.
#
# Note on two names that usually appear in a Python .gitignore and deliberately
# do not appear here: `dist/` and `build/` are not ignored as bare names,
# because `dist/` is curated public record and demo video, and
# `submission/pitch/build/` holds the two pitch build scripts. Only the
# root-level Python build directory is ignored, by path.

# Virtual environments (named without a trailing separator, which the
# leakage scan forbids in prose; git ignores a matched directory whole)
.venv
venv/
env/
ENV/
.python-version

# Byte-code and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyre/
.pytype/

# Build artifacts (root-level only; see the note above)
/build/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# Coverage and test output
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
nosetests.xml

# Node
node_modules/
npm-debug.log*
yarn-error.log*
.npm/
.pnpm-store/

# Office lock and recovery files
~$*
*.tmp
.~lock.*#

# macOS metadata
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Local environment and configuration, never published
.env
.env.*
!.env.example
*.local
.aws/
.claude/local-settings.json

# Private evidence, never published
evidence/
private-evidence/
.evidence/
scratch/

# Local working records (gates, audits, canary notes), never published
.unlazy/
